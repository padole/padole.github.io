# Copy this file to .env and fill in your values.

# Your live site address, no trailing slash. Used for SEO tags (canonical URL, social preview image).
VITE_SITE_URL=https://www.example.com

# Optional: a Formspree (or compatible) endpoint so the contact form sends email directly.
# Create a free form at https://formspree.io and paste its endpoint, e.g. https://formspree.io/f/abcdwxyz
# Leave empty and the form opens the visitor's email app with the message pre-filled instead.
VITE_FORM_ENDPOINT=
